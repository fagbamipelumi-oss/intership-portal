SECRET_KEY=change-this-to-a-random-string
# Leave DATABASE_URL unset to use SQLite locally (no install needed).
# For hosted deployments, use the PostgreSQL URL supplied by your provider:
# DATABASE_URL=postgresql+psycopg://user:password@host/database
# Or use MySQL locally:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost/internship_portal
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
